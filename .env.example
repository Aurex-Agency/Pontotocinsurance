# Supabase Configuration
# Copy this file to `.env.local` and fill in the values from your Supabase
# dashboard (Settings > API). Never commit real keys or passwords.

# Public values (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://ndgzmalrirbbeqbrgrjo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — keep this server-side only. Required for admin panel writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: direct PostgreSQL connection (only needed by some maintenance scripts)
# DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.ndgzmalrirbbeqbrgrjo.supabase.co:5432/postgres

# GLP-1 quiz funnel (/glp1-quiz)
# Optional. The GoHighLevel inbound webhook for quiz leads is already wired as
# the default in app/api/glp1-lead/route.ts. Only set this to override it.
# GHL_WEBHOOK_URL=
# Public GoHighLevel booking calendar embed URL shown on the result page.
NEXT_PUBLIC_GHL_CALENDAR_URL=https://link.pontotocinsuranceagency.com/widget/booking/PLACEHOLDER
# Meta (Facebook) Pixel. Optional. Leave unset so all funnels (webinar and
# GLP-1 quiz) share the same pixel baked into the MetaPixel component. Only set
# this to override every funnel with a different pixel ID.
# NEXT_PUBLIC_META_PIXEL_ID=
